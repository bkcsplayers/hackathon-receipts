# ===== Database (Docker defaults) =====
DATABASE_URL=postgresql+asyncpg://receipt_user:receipt_pass@postgres:5432/hackathon_receipt
DATABASE_URL_SYNC=postgresql://receipt_user:receipt_pass@postgres:5432/hackathon_receipt

# ===== JWT (required — generate a random string) =====
JWT_SECRET_KEY=change-this-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== Admin seed / login (Mobile & Dashboard use username, not email) =====
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD

# ===== Email encryption (required — Fernet key) =====
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_ENCRYPTION_KEY=

# ===== AI — OpenRouter (recommended) or DeepSeek direct =====
# OpenRouter: https://openrouter.ai/keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_MODEL=anthropic/claude-sonnet-4
DEEPSEEK_VISION_MODEL=anthropic/claude-sonnet-4

# DeepSeek direct (alternative):
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_VISION_MODEL=deepseek-chat

# ===== Cloudflare R2 (required — image storage) =====
R2_ENDPOINT=
R2_BUCKET_NAME=hackathon-receipt-helper
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_DOMAIN=

# ===== Mapbox (required — map + geocoding) =====
# https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=

# ===== Telegram (optional — upload notifications) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ===== CloudCone Email (optional — email receipt scanning) =====
EMAIL_IMAP_HOST=mail.yourdomain.com
EMAIL_IMAP_PORT=993

EMAIL_1_IMAP_HOST=mail.yourdomain.com
EMAIL_1_IMAP_PORT=993
EMAIL_1_ADDRESS=admin-receipts@yourdomain.com
EMAIL_1_PASSWORD=

EMAIL_2_ADDRESS=membera-receipts@yourdomain.com
EMAIL_2_PASSWORD=

EMAIL_3_ADDRESS=memberb-receipts@yourdomain.com
EMAIL_3_PASSWORD=

EMAIL_4_ADDRESS=memberc-receipts@yourdomain.com
EMAIL_4_PASSWORD=

# ===== App =====
APP_NAME=Hackathon Receipt Helper
CORS_ORIGINS=http://localhost:4511,http://localhost:4512
DEFAULT_CURRENCY=CAD
DASHBOARD_URL=http://localhost:4512
MOBILE_URL=http://localhost:4511
# Docker compose overrides DASHBOARD_URL/MOBILE_URL to http://dashboard:4512 etc.
DASHBOARD_PUBLIC_URL=http://localhost:4512
MOBILE_PUBLIC_URL=http://localhost:4511
LLM_COST_INPUT_PER_1M=3.0
LLM_COST_OUTPUT_PER_1M=15.0

# Frontend (local dev — optional, docker-compose sets these)
VITE_API_URL=http://localhost:4510

# See docs/14-environment-variables.md for details
